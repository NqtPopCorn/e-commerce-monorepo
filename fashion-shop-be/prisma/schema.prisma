generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  firstName String?    @map("first_name")
  lastName  String?    @map("last_name")
  role      Role       @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  orders    Order[]

  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]

  @@map("brands")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  description      String?
  brandId          Int?             @map("brand_id")
  categoryId       Int?             @map("category_id")
  material         String?
  careInstructions String?          @map("care_instructions")
  season           String?
  provider         String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  category         Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                Int                @id @default(autoincrement())
  productId         Int                @map("product_id")
  sku               String             @unique
  barcode           String?            @unique
  size              String?
  color             String?
  colorHex          String?            @map("color_hex")
  imageUrl          String?            @map("image_url")
  listPrice         Decimal            @db.Decimal(12, 2) @map("list_price")
  sellingPrice      Decimal            @db.Decimal(12, 2) @map("selling_price")
  stock             Int                @default(0)
  weight            Int?
  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems     PurchaseReceiptItem[]
  orderItems        OrderItem[]
  promotionVariants PromotionVariant[]

  @@index([productId])
  @@map("product_variants")
}

model PurchaseReceipt {
  id          Int                   @id @default(autoincrement())
  code        String                @unique
  supplier    String                @default("Fashion Shop Official")
  note        String?
  totalAmount Decimal               @default(0) @db.Decimal(12, 2) @map("total_amount")
  status      String                @default("COMPLETED")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  items       PurchaseReceiptItem[]

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id        Int             @id @default(autoincrement())
  receiptId Int             @map("receipt_id")
  variantId Int             @map("variant_id")
  quantity  Int             @default(0)
  costPrice Decimal         @default(0) @db.Decimal(12, 2) @map("cost_price")

  receipt   PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant   ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([receiptId])
  @@index([variantId])
  @@map("purchase_receipt_items")
}

enum PromotionKind {
  VOUCHER
  ORDER_AUTO
  CAMPAIGN
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionApplicationScope {
  LINE
  ORDER
  VOUCHER
}

model Promotion {
  id             Int                    @id @default(autoincrement())
  name           String
  kind           PromotionKind
  code           String?                @unique
  discountType     DiscountType?
  discountValue    Decimal?               @db.Decimal(12, 2)
  maxDiscountValue Decimal?               @map("max_discount_value") @db.Decimal(12, 2)
  minOrderAmount   Decimal?               @map("min_order_amount") @db.Decimal(12, 2)
  priority         Int                    @default(0)
  maxUses          Int?                   @map("max_uses")
  usedCount      Int                    @default(0) @map("used_count")
  startsAt       DateTime               @map("starts_at")
  endsAt         DateTime?              @map("ends_at")
  active         Boolean                @default(true)
  groups         PromotionGroup[]
  applications   PromotionApplication[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([kind, active, startsAt, endsAt])
  @@index([kind, priority])
  @@map("promotions")
}

model PromotionGroup {
  id            Int                @id @default(autoincrement())
  promotionId   Int                @map("promotion_id")
  name          String
  sortOrder     Int                @default(0) @map("sort_order")
  discountType  DiscountType       @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(12, 2)
  promotion     Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variants      PromotionVariant[]

  @@index([promotionId, sortOrder])
  @@map("promotion_groups")
}

model PromotionVariant {
  groupId   Int            @map("group_id")
  variantId Int            @map("variant_id")
  group     PromotionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@id([groupId, variantId])
  @@index([variantId])
  @@map("promotion_variants")
}

model PromotionApplication {
  id             Int                       @id @default(autoincrement())
  orderId        Int                       @map("order_id")
  orderItemId    Int?                      @map("order_item_id")
  promotionId    Int                       @map("promotion_id")
  scope          PromotionApplicationScope
  promotionName  String                    @map("promotion_name")
  promotionCode  String?                   @map("promotion_code")
  discountAmount Decimal                   @map("discount_amount") @db.Decimal(12, 2)
  order          Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem?                @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  promotion      Promotion                 @relation(fields: [promotionId], references: [id])

  @@index([orderId])
  @@index([promotionId])
  @@map("promotion_applications")
}

model Order {
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @map("user_id")
  status                OrderStatus            @default(PENDING)
  subtotal              Decimal                @default(0) @db.Decimal(12, 2)
  productDiscount       Decimal                @default(0) @map("product_discount") @db.Decimal(12, 2)
  orderDiscount         Decimal                @default(0) @map("order_discount") @db.Decimal(12, 2)
  voucherDiscount       Decimal                @default(0) @map("voucher_discount") @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  user                  User                   @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  promotionApplications PromotionApplication[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

model OrderItem {
  id                    Int                    @id @default(autoincrement())
  orderId               Int                    @map("order_id")
  variantId             Int                    @map("variant_id")
  quantity              Int
  originalUnitPrice     Decimal                @default(0) @map("original_unit_price") @db.Decimal(12, 2)
  productDiscount       Decimal                @default(0) @map("product_discount") @db.Decimal(12, 2)
  finalUnitPrice        Decimal                @default(0) @map("final_unit_price") @db.Decimal(12, 2)
  unitPrice             Decimal                @default(0) @map("unit_price") @db.Decimal(12, 2)
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant               ProductVariant         @relation(fields: [variantId], references: [id])
  promotionApplications PromotionApplication[]

  @@unique([orderId, variantId])
  @@map("order_items")
}
