generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  firstName   String?      @map("first_name")
  lastName    String?      @map("last_name")
  phone       String?      @unique
  avatarUrl   String?      @map("avatar_url")
  gender      Gender?
  dateOfBirth DateTime?    @map("date_of_birth")
  role        Role         @default(CUSTOMER)
  status      UserStatus   @default(ACTIVE)
  tier        CustomerTier @default(STANDARD)
  notes       String?
  lastLoginAt DateTime?    @map("last_login_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  orders        Order[]
  addresses     Address[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([role, status])
  @@index([phone])
  @@map("users")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  DIAMOND
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  recipientName String   @map("recipient_name")
  phone         String
  street        String
  ward          String?
  district      String?
  city          String
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  logo     String?
  products Product[]

  @@map("brands")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  parentId Int?       @map("parent_id")
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String
  slug             String           @unique
  description      String?
  brandId          Int?             @map("brand_id")
  categoryId       Int?             @map("category_id")
  material         String?
  careInstructions String?          @map("care_instructions")
  season           String?
  provider         String?
  brand            Brand?           @relation(fields: [brandId], references: [id])
  category         Category?        @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([brandId])
  @@index([categoryId])
  @@map("products")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  url       String
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id                Int                   @id @default(autoincrement())
  productId         Int                   @map("product_id")
  sku               String                @unique
  barcode           String?               @unique
  size              String?
  color             String?
  colorHex          String?               @map("color_hex")
  imageUrl          String?               @map("image_url")
  listPrice         Decimal               @map("list_price") @db.Decimal(12, 2)
  sellingPrice      Decimal               @map("selling_price") @db.Decimal(12, 2)
  stock             Int                   @default(0)
  weight            Int?
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseItems     PurchaseReceiptItem[]
  orderItems        OrderItem[]
  promotionVariants PromotionVariant[]

  @@index([productId])
  @@map("product_variants")
}

model PurchaseReceipt {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  supplier    String   @default("Fashion Shop Official")
  note        String?
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  status      String   @default("COMPLETED")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items PurchaseReceiptItem[]

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id        Int     @id @default(autoincrement())
  receiptId Int     @map("receipt_id")
  variantId Int     @map("variant_id")
  quantity  Int     @default(0)
  costPrice Decimal @default(0) @map("cost_price") @db.Decimal(12, 2)

  receipt PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  variant ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([receiptId])
  @@index([variantId])
  @@map("purchase_receipt_items")
}

enum PromotionApplicationType {
  AUTO
  VOUCHER
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionApplicationScope {
  LINE
  ORDER
  VOUCHER
}

model Campaign {
  id          Int            @id @default(autoincrement())
  name        String
  description String?
  startsAt    DateTime       @map("starts_at")
  endsAt      DateTime?      @map("ends_at")
  budgetLimit Decimal?       @map("budget_limit") @db.Decimal(12, 2)
  spentAmount Decimal        @default(0) @map("spent_amount") @db.Decimal(12, 2)
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  promotions Promotion[]

  @@index([status, startsAt, endsAt])
  @@map("campaigns")
}

model Promotion {
  id              Int                      @id @default(autoincrement())
  campaignId      Int?                     @map("campaign_id")
  name            String
  description     String?
  applicationType PromotionApplicationType @default(AUTO) @map("application_type")
  minOrderAmount  Decimal?                 @map("min_order_amount") @db.Decimal(12, 2)
  priority        Int                      @default(0)
  budgetLimit     Decimal?                 @map("budget_limit") @db.Decimal(12, 2)
  spentAmount     Decimal                  @default(0) @map("spent_amount") @db.Decimal(12, 2)
  maxUses         Int?                     @map("max_uses")
  usedCount       Int                      @default(0) @map("used_count")
  startsAt        DateTime                 @map("starts_at")
  endsAt          DateTime?                @map("ends_at")
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  campaign     Campaign?              @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  groups       PromotionGroup[]
  vouchers     Voucher[]
  applications PromotionApplication[]

  @@index([campaignId])
  @@index([applicationType, active, startsAt, endsAt])
  @@index([applicationType, priority])
  @@map("promotions")
}

model Voucher {
  id                 Int       @id @default(autoincrement())
  promotionId        Int       @map("promotion_id")
  code               String    @unique
  maxUses            Int?      @map("max_uses")
  usedCount          Int       @default(0) @map("used_count")
  maxUsesPerCustomer Int?      @default(1) @map("max_uses_per_customer")
  startsAt           DateTime? @map("starts_at")
  endsAt             DateTime? @map("ends_at")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([promotionId, active])
  @@map("vouchers")
}

model PromotionGroup {
  id               Int                @id @default(autoincrement())
  promotionId      Int                @map("promotion_id")
  name             String
  sortOrder        Int                @default(0) @map("sort_order")
  discountType     DiscountType       @map("discount_type")
  discountValue    Decimal            @map("discount_value") @db.Decimal(12, 2)
  maxDiscountValue Decimal?           @map("max_discount_value") @db.Decimal(12, 2)
  promotion        Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variants         PromotionVariant[]

  @@index([promotionId, sortOrder])
  @@map("promotion_groups")
}

model PromotionVariant {
  groupId   Int            @map("group_id")
  variantId Int            @map("variant_id")
  group     PromotionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@id([groupId, variantId])
  @@index([variantId])
  @@map("promotion_variants")
}

model PromotionApplication {
  id             Int                       @id @default(autoincrement())
  orderId        Int                       @map("order_id")
  orderItemId    Int?                      @map("order_item_id")
  promotionId    Int                       @map("promotion_id")
  scope          PromotionApplicationScope
  promotionName  String                    @map("promotion_name")
  promotionCode  String?                   @map("promotion_code")
  discountAmount Decimal                   @map("discount_amount") @db.Decimal(12, 2)
  order          Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem?                @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  promotion      Promotion                 @relation(fields: [promotionId], references: [id])

  @@index([orderId])
  @@index([promotionId])
  @@map("promotion_applications")
}

model Order {
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @map("user_id")
  status                OrderStatus            @default(PENDING)
  paymentMethod         PaymentMethod          @default(COD) @map("payment_method")
  paymentStatus         PaymentStatus          @default(UNPAID) @map("payment_status")
  recipientName         String?                @map("recipient_name")
  recipientPhone        String?                @map("recipient_phone")
  shippingAddress       String?                @map("shipping_address")
  shippingNote          String?                @map("shipping_note")
  subtotal              Decimal                @default(0) @db.Decimal(12, 2)
  productDiscount       Decimal                @default(0) @map("product_discount") @db.Decimal(12, 2)
  orderDiscount         Decimal                @default(0) @map("order_discount") @db.Decimal(12, 2)
  voucherDiscount       Decimal                @default(0) @map("voucher_discount") @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  user                  User                   @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  promotionApplications PromotionApplication[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model OrderItem {
  id                    Int                    @id @default(autoincrement())
  orderId               Int                    @map("order_id")
  variantId             Int                    @map("variant_id")
  quantity              Int
  originalUnitPrice     Decimal                @default(0) @map("original_unit_price") @db.Decimal(12, 2)
  productDiscount       Decimal                @default(0) @map("product_discount") @db.Decimal(12, 2)
  finalUnitPrice        Decimal                @default(0) @map("final_unit_price") @db.Decimal(12, 2)
  unitPrice             Decimal                @default(0) @map("unit_price") @db.Decimal(12, 2)
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant               ProductVariant         @relation(fields: [variantId], references: [id])
  promotionApplications PromotionApplication[]

  @@unique([orderId, variantId])
  @@map("order_items")
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?     @map("user_id")
  userEmail    String?  @map("user_email")
  userRole     String?  @map("user_role")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  description  String?
  oldValue     Json?    @map("old_value")
  newValue     Json?    @map("new_value")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  status       String   @default("SUCCESS")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([status])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationType {
  ORDER
  INVENTORY
  SYSTEM
}

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        Int               @id @default(autoincrement())
  userId    Int               @map("user_id")
  title     String
  message   String
  type      NotificationType  @default(SYSTEM)
  level     NotificationLevel @default(INFO)
  link      String?
  isRead    Boolean           @default(false) @map("is_read")
  readAt    DateTime?         @map("read_at")
  data      Json?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum OtpType {
  FORGOT_PASSWORD
  PHONE_VERIFICATION
  ORDER_CONFIRMATION
  LOGIN
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  target    String   // Email hoặc số điện thoại
  code      String   // Mã OTP 6 chữ số
  type      OtpType  @default(FORGOT_PASSWORD)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([target, type, used])
  @@map("otp_verifications")
}
