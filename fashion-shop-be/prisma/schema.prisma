generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  firstName String?    @map("first_name")
  lastName  String?    @map("last_name")
  role      Role       @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  orders    Order[]

  @@map("users")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  books Book[]

  @@map("categories")
}

model Batch {
  id        Int         @id @default(autoincrement())
  code      String      @unique
  quantity  Int         @default(0)
  variantId Int         @map("variant_id")
  variant   BookVariant @relation(fields: [variantId], references: [id])
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([variantId])
  @@map("batches")
}

model Book {
  id           Int           @id @default(autoincrement())
  title        String
  description  String?
  authors      Json?
  categoryId   Int?          @map("category_id")
  publisher    String?
  translators  Json?
  provider     String?
  publishYear  Int?          @map("publish_year")
  language     String?
  category     Category?     @relation(fields: [categoryId], references: [id])
  variants     BookVariant[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([categoryId])
  @@map("books")
}

model BookVariant {
  id                Int                @id @default(autoincrement())
  bookId            Int                @map("book_id")
  sku               String             @unique
  isbn              String?            @unique
  format            String?            // e.g., "Bìa cứng", "Bìa mềm"
  imageUrl          String?            @map("image_url")
  listPrice         Decimal            @db.Decimal(12, 2) @map("list_price")
  sellingPrice      Decimal            @db.Decimal(12, 2) @map("selling_price")
  stock             Int                @default(0)
  weight            Int?
  dimensions        String?
  pages             Int?
  book              Book               @relation(fields: [bookId], references: [id], onDelete: Cascade)
  batches           Batch[]
  orderItems        OrderItem[]
  promotionVariants PromotionVariant[]

  @@index([bookId])
  @@map("book_variants")
}

enum PromotionKind {
  VOUCHER
  ORDER_AUTO
  CAMPAIGN
}

enum DiscountType {
  PERCENT
  FIXED
}

enum PromotionApplicationScope {
  LINE
  ORDER
  VOUCHER
}

model Promotion {
  id             Int                    @id @default(autoincrement())
  name           String
  kind           PromotionKind
  code           String?                @unique
  discountType   DiscountType?
  discountValue  Decimal?               @db.Decimal(12, 2)
  minOrderAmount Decimal?               @map("min_order_amount") @db.Decimal(12, 2)
  priority       Int                    @default(0)
  maxUses        Int?                   @map("max_uses")
  usedCount      Int                    @default(0) @map("used_count")
  startsAt       DateTime               @map("starts_at")
  endsAt         DateTime?              @map("ends_at")
  active         Boolean                @default(true)
  groups         PromotionGroup[]
  applications   PromotionApplication[]
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  @@index([kind, active, startsAt, endsAt])
  @@index([kind, priority])
  @@map("promotions")
}

model PromotionGroup {
  id            Int                @id @default(autoincrement())
  promotionId   Int                @map("promotion_id")
  name          String
  sortOrder     Int                @default(0) @map("sort_order")
  discountType  DiscountType       @map("discount_type")
  discountValue Decimal            @map("discount_value") @db.Decimal(12, 2)
  promotion     Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  variants      PromotionVariant[]

  @@index([promotionId, sortOrder])
  @@map("promotion_groups")
}

model PromotionVariant {
  groupId   Int            @map("group_id")
  variantId Int            @map("variant_id")
  group     PromotionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  variant   BookVariant    @relation(fields: [variantId], references: [id])

  @@id([groupId, variantId])
  @@index([variantId])
  @@map("promotion_variants")
}

model PromotionApplication {
  id             Int                       @id @default(autoincrement())
  orderId        Int                       @map("order_id")
  orderItemId    Int?                      @map("order_item_id")
  promotionId    Int                       @map("promotion_id")
  scope          PromotionApplicationScope
  promotionName  String                    @map("promotion_name")
  promotionCode  String?                   @map("promotion_code")
  discountAmount Decimal                   @map("discount_amount") @db.Decimal(12, 2)
  order          Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem?                @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  promotion      Promotion                 @relation(fields: [promotionId], references: [id])

  @@index([orderId])
  @@index([promotionId])
  @@map("promotion_applications")
}

model Order {
  id                    Int                    @id @default(autoincrement())
  userId                Int                    @map("user_id")
  status                OrderStatus            @default(PENDING)
  subtotal              Decimal                @default(0) @db.Decimal(12, 2)
  productDiscount       Decimal                @default(0) @map("product_discount") @db.Decimal(12, 2)
  orderDiscount         Decimal                @default(0) @map("order_discount") @db.Decimal(12, 2)
  voucherDiscount       Decimal                @default(0) @map("voucher_discount") @db.Decimal(12, 2)
  total                 Decimal                @db.Decimal(12, 2)
  user                  User                   @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  promotionApplications PromotionApplication[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([userId, status])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

model OrderItem {
  id                    Int                    @id @default(autoincrement())
  orderId               Int                    @map("order_id")
  variantId             Int                    @map("variant_id")
  quantity              Int
  originalUnitPrice     Decimal                @default(0) @map("original_unit_price") @db.Decimal(12, 2)
  productDiscount       Decimal                @default(0) @map("product_discount") @db.Decimal(12, 2)
  finalUnitPrice        Decimal                @default(0) @map("final_unit_price") @db.Decimal(12, 2)
  unitPrice             Decimal                @default(0) @map("unit_price") @db.Decimal(12, 2)
  order                 Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant               BookVariant            @relation(fields: [variantId], references: [id])
  promotionApplications PromotionApplication[]

  @@unique([orderId, variantId])
  @@map("order_items")
}
